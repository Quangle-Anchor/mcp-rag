# ── LLM Providers ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=AIza...

# ── Vector DB ─────────────────────────────────────────────────────────────────
VECTOR_DB_BACKEND=chroma                  # "chroma" | "qdrant"
CHROMA_PERSIST_DIR=./data/chroma_db
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── Relational DB ─────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/rag_app.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/ragdb

# ── Celery / Redis ────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── App Settings ──────────────────────────────────────────────────────────────
APP_ENV=development                       # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ── RAG Tuning ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RETRIEVAL=5
COLLECTION_NAME=rag_documents

# ── Pinecone ─────────────────────────────────────────────────────────────────
PINECONE_API_KEY=
PINECONE_INDEX_NAME=mendix-rag
PINECONE_NAMESPACE=mendix-docs

# ── Tool Specification Docs (for --sync tool) ─────────────────────────────────
# Absolute path to the directory containing Tool Specification .md files.
# Each file must contain <!-- tool_start id="N" name="fn_name" --> blocks.
TOOL_DOCS_DIR=/path/to/your/tool-specs
